rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email', 'displayName', 'role', 'createdAt']) &&
        data.id is string && isValidId(data.id) &&
        data.email is string && data.email.size() <= 256 &&
        data.displayName is string && data.displayName.size() <= 100 &&
        data.role is string && data.role.size() <= 60 &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
        (!('lastLogin' in data) || (data.lastLogin is string && data.lastLogin.size() <= 40));
    }

    function isValidAccessRequest(data) {
      return data.keys().hasAll(['id', 'fullName', 'workEmail', 'propertyName', 'createdAt']) &&
        data.id is string && isValidId(data.id) &&
        data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 100 &&
        data.workEmail is string && data.workEmail.size() > 0 && data.workEmail.size() <= 256 &&
        data.propertyName is string && data.propertyName.size() > 0 && data.propertyName.size() <= 150 &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        (!('roomCount' in data) || (data.roomCount is string && data.roomCount.size() <= 50));
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isSignedIn() && resource.data.id == request.auth.uid;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().id == userId;
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().id == existing().id;
      allow delete: if false;
    }

    // Access Requests from Landing Page
    match /access_requests/{requestId} {
      allow create: if isValidId(requestId) && isValidAccessRequest(incoming());
      allow get, list: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
